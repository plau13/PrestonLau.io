{
  "name": "prestonlau",
  "description": "Preston Lau — personal portfolio",
  "version": "2.0.0",
  "author": "Preston Lau <Preston.lau13@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/plau13/prestonlau"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npm run build && npx serve out -p 3000",
    "start": "next start",
    "deploy": "npm run build && npx wrangler deploy",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "lint-staged": "lint-staged",
    "prepare": "node -e \"if (process.env.CI || process.env.CF_PAGES) process.exit(0); try { require('child_process').execSync('husky install', { stdio: 'inherit' }); } catch (e) { process.exit(0); }\""
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^14.2.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "styled-components": "^6.1.17"
  },
  "lint-staged": {
    "*.{js,css,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.28",
    "husky": "^6.0.0",
    "lint-staged": "^10.1.2",
    "prettier": "^2.2.1",
    "wrangler": "^4.14.0"
  }
}
