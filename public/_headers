# HTML: always revalidate so deploys show up without a hard refresh
/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/404.html
  Cache-Control: no-cache, must-revalidate

# Next.js hashed assets: safe to cache forever (filename changes on update)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Versioned PDFs: immutable (use a new dated filename when you update them)
/Preston_Lau_Resume_2026-08-28.pdf
  Cache-Control: public, max-age=31536000, immutable

/slides/*
  Cache-Control: public, max-age=31536000, immutable

# Images and icons: short cache, revalidate often
/images/*
  Cache-Control: public, max-age=3600, must-revalidate

/icon
  Cache-Control: public, max-age=3600, must-revalidate

/apple-icon
  Cache-Control: public, max-age=3600, must-revalidate

/og.png
  Cache-Control: public, max-age=3600, must-revalidate

/og@2x.png
  Cache-Control: public, max-age=3600, must-revalidate
